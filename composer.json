{
  "name": "omid-khd/exception-handler",
  "description": "A flexible and extensible exception handler for PHP applications.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "exception",
    "exception-handler",
    "error-handler",
    "middleware",
    "http",
    "translation"
  ],
  "autoload": {
    "psr-4": {
      "ExceptionHandler\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\ExceptionHandler\\": "tests/"
    }
  },
  "require": {
    "php": ">=8.3",
    "psr/container": "^2.0",
    "psr/http-message": "^1.0",
    "webmozart/assert": "^2.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  }
}
